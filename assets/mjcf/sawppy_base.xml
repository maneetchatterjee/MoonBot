<mujoco model="MoonBot-X Sawppy-derived mobile Panda">
  <compiler angle="radian" autolimits="true" inertiafromgeom="auto"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" solver="Newton"
          iterations="120" cone="pyramidal" impratio="20" noslip_iterations="20"/>
  <size nconmax="800" njmax="3000"/>
