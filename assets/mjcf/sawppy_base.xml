    <global offwidth="1280" offheight="720"/>
    <headlight ambient="0.32 0.32 0.32" diffuse="0.75 0.75 0.75" specular="0.25 0.25 0.25"/>
  </visual>
  <default>
    <joint armature="0.01" damping="0.08" frictionloss="0.02"/>
    <geom condim="6" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <default class="suspension">
      <joint type="hinge" axis="0 1 0" armature="0.08" damping="2.0" frictionloss="0.18"/>
    </default>
    <default class="steering">
      <joint type="hinge" axis="0 0 1" armature="0.04" damping="0.8" frictionloss="0.08" range="-0.75 0.75"/>
    </default>
    <default class="wheel">
      <joint type="hinge" axis="0 1 0" damping="0.18" armature="0.06" limited="false"/>
      <geom type="cylinder" size="0.12 0.10" rgba="0.055 0.06 0.065 1"
            friction="1.25 0.02 0.003" priority="1" solref="0.003 1"/>
    </default>
  </default>
