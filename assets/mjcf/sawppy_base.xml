    <texture name="ground" type="2d" builtin="checker" rgb1="0.20 0.23 0.25" rgb2="0.13 0.15 0.17" width="512" height="512"/>
    <material name="ground" texture="ground" texrepeat="3 3" reflectance="0.05"/>
    <material name="rover_dark" rgba="0.16 0.18 0.20 1"/>
    <material name="rover_metal" rgba="0.36 0.39 0.42 1" specular="0.4" shininess="0.3"/>
    <mesh name="sawppy_body" file="../meshes/sawppy/body_box.stl" scale="2 2 2"/>
    <mesh name="sawppy_differential" file="../meshes/sawppy/differential.stl" scale="2 2 2"/>
